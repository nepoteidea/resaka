{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resaka",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "resaka.nepoteidea.com", "custom_domain": true }],
  "preview_urls": true,
}
